# Supabase environment variables (get these from your Supabase dashboard)
#
# IMPORTANT: This is a Vite app. The browser client (src/integrations/supabase/client.ts)
# reads the VITE_-prefixed vars, which Vite inlines at BUILD time. Only vars prefixed
# with VITE_ are exposed to the client bundle — NEXT_PUBLIC_* vars are ignored here.
#
# If the VITE_ values are missing or left as placeholders at build time, the app ships
# calling https://your_project_id.supabase.co and every request fails with "Failed to fetch".
# On Vercel, set VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY / VITE_SUPABASE_PROJECT_ID
# in Project Settings → Environment Variables (Production, Preview, Development).
#
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY (no prefix) are the SSR fallbacks (process.env).
# The publishable key (sb_publishable_...) is safe to expose in the browser with RLS enabled.

SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
